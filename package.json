  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "firebase-admin": "^13.10.0",
    "playwright": "^1.62.1",
    "stripe": "^22.3.0",
    "supercompress-proxy": "^0.5.27"

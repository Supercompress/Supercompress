    "launch:check": "bash scripts/hard-launch-check.sh",
    "launch:readiness": "bash scripts/launch-readiness.sh",
    "launch:bench": "bash scripts/gtm_bench/run_launch_hour.sh",
    "launch:bench-fast": "bash scripts/gtm_bench/run_fast_finish.sh",
    "launch:bench-watch": "bash scripts/gtm_bench/watch_bench.sh",
    "launch:bench-sla": "bash scripts/launch/benchmark-sla.sh",
    "launch:t0": "bash scripts/launch/t0.sh",
    "launch:morning-t0": "bash scripts/launch/morning-t0.sh",
    "launch:post-deploy": "bash scripts/launch/post-deploy-smoke.sh",
    "launch:neural-fly": "bash scripts/launch/neural-fly-go-live.sh --full",
    "launch:graphics": "bash scripts/launch/render-graphics.sh",
    "launch:pricing-30c": "bash scripts/launch/apply-pricing-30c.sh",
    "launch:recording": "bash scripts/launch/open-recording-tabs.sh",

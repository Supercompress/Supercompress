{
  "name": "supercompress",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "node scripts/test-unit.js",
    "test:unit": "node scripts/test-unit.js",
    "test:proxy": "npm --prefix packages/proxy test",
    "deploy:prod": "bash scripts/deploy-prod.sh",
    "prod:smoke": "bash scripts/prod-smoke.sh",
    "prod:domains": "bash scripts/ensure-prod-domains.sh",
    "check:api-host": "node scripts/check-api-host-routes.js",
    "check:firebase-auth": "node scripts/check-firebase-auth-proxy.js",
    "check:stylesheet-paths": "node scripts/check-stylesheet-paths.test.js && node scripts/check-stylesheet-paths.js",
    "check:assets": "node scripts/sync-compress-assets.js --check",
    "release:check": "bash scripts/release-check.sh",
    "sync:assets": "node scripts/sync-compress-assets.js",
    "mcp": "node mcp/server.js",
    "check:version": "node scripts/check-versions.js",
    "test:neural-keep": "node --test api/_lib/neural-keep.test.js",
    "test:arena": "bash scripts/arena-smoke.sh",
    "deploy:api": "bash scripts/deploy-api.sh",
    "start:api": "node services/api/server.js",
    "test:api": "node --test services/api/*.test.js",
    "api:smoke": "node scripts/fly-api-smoke.js"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "firebase-admin": "^13.10.0",
    "playwright": "^1.64.1",
    "stripe": "^23.0.1",
    "supercompress-proxy": "^0.5.40"
  },
  "overrides": {
    "ip-address": "10.3.1"
  }
}

{
  "name": "supercompress-proxy",
  "version": "0.5.14",
  "description": "SuperCompress \u2014 MCP-first coding-agent plugin. Fast global install (no heavy MCP SDK). Every submit with context auto-compresses; tiny asks skip. Optional local API proxy.",
  "keywords": [
    "supercompress",
    "prompt-compression",
    "mcp",
    "cursor",
    "claude-code",
    "codex",
    "freebuff",
    "opencode",
    "hermes",
    "openclaw",
    "token-compression",
    "llm-cost"
  ],
  "homepage": "https://supercompress.dev/docs/coding-agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Supercompress/Supercompress.git",
    "directory": "packages/proxy"
  },
  "license": "MIT",
  "type": "commonjs",
  "main": "src/server.js",
  "bin": {
    "supercompress": "bin/supercompress.js",
    "supercompress-mcp": "src/mcp.js"
  },
  "files": [
    "bin/",
    "src/",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "test": "node test/run-all.js",
    "test:smoke": "node test/smoke.js",
    "test:uninstall": "node test/uninstall-clean.js",
    "test:review": "node test/review.js",
    "test:dual": "node test/dual-launch.js",
    "test:compress": "node test/compress-deep.js",
    "test:launch": "node test/launch-ready.js",
    "test:bugs": "node test/bug-hunt.js",
    "test:hermes": "node test/hermes-comprehensive.js",
    "test:all": "node test/run-all.js",
    "setup": "node bin/supercompress.js setup",
    "start": "node bin/supercompress.js start",
    "stop": "node bin/supercompress.js stop",
    "status": "node bin/supercompress.js status",
    "postinstall": "node bin/install.js"
  },
  "dependencies": {
    "express": "4.22.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

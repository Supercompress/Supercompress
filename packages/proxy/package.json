{
  "name": "supercompress-proxy",
  "version": "0.5.23",
  "description": "SuperCompress for coding agents \u2014 run setup once to auto-install MCP + hooks and cut ~65% of LLM input tokens. Benchmarks at supercompress.dev/benchmarks.",
  "keywords": [
    "supercompress",
    "prompt-compression",
    "coding-agents",
    "claude-code",
    "codex",
    "cursor",
    "token-compression",
    "llm-cost",
    "context-compression",
    "opencode",
    "aider",
    "hermes",
    "openclaw"
  ],
  "homepage": "https://docs.supercompress.dev/coding-agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Supercompress/Supercompress.git",
    "directory": "packages/proxy"
  },
  "license": "MIT",
  "type": "commonjs",
  "main": "src/server.js",
  "bin": {
    "supercompress": "bin/supercompress.js",
    "supercompress-mcp": "src/mcp.js"
  },
  "files": [
    "bin/",
    "src/",
    "tui/",
    "LICENSE",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "test": "node test/run-all.js",
    "test:smoke": "node test/smoke.js",
    "test:sse": "node test/sse-stream.js",
    "test:review": "node test/review.js",
    "test:dual": "node test/dual-launch.js",
    "test:compress": "node test/compress-deep.js",
    "test:launch": "node test/launch-ready.js",
    "test:bugs": "node test/bug-hunt.js",
    "test:all": "node test/run-all.js",
    "setup": "node bin/supercompress.js setup",
    "start": "node bin/supercompress.js start",
    "stop": "node bin/supercompress.js stop",
    "status": "node bin/supercompress.js status",
    "sync:assets": "node ../../scripts/sync-compress-assets.js",
    "prepack": "npm run sync:assets",
    "postinstall": "node bin/install.js"
  },
  "dependencies": {
    "express": "4.22.2"
  },
  "optionalDependencies": {
    "@opentui/core": "0.5.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

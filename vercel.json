    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "docs.supercompress.dev"
        }
      ],
      "destination": "/docs",
      "permanent": false
    },
    {
      "source": "/docs",
      "has": [
        {
          "type": "host",
          "value": "www.supercompress.dev"
        }
      ],
      "destination": "https://docs.supercompress.dev/",
      "permanent": true
    },
    {
